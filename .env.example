PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=
LOCAL_DATABASE_PATH=.data/postgres
GOOGLE_CLIENT_ID=
SESSION_SECRET=replace-with-at-least-32-random-characters
RUNNER_TOKEN=replace-with-a-different-32-character-random-value
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
PDF_BROWSER_PATH=
# Production requires DATABASE_URL, HTTPS origin, strong secrets and isolated runner.
# Runner only: Linux /dev/kvm, firecracker binary, immutable kernel/rootfs.
API_URL=http://localhost:3001
FIRECRACKER_BIN=/usr/local/bin/firecracker
KERNEL_PATH=/opt/algostep/vmlinux
ROOTFS_PATH=/opt/algostep/rootfs.ext4
RUNNER_WORKDIR=/var/lib/algostep
RUNNER_SLOTS=2
