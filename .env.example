PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=
DATABASE_SCHEMA=algostep
# Supabase: absolute path to the public CA certificate from its dashboard.
DATABASE_SSL_CA=
LOCAL_DATABASE_PATH=.data/postgres
GOOGLE_CLIENT_ID=
SESSION_SECRET=replace-with-at-least-32-random-characters
RUNNER_TOKEN=replace-with-a-different-32-character-random-value
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BACKEND=developer
# Use vertex-express for a Vertex/Agent Platform Express API key.
# Optional legacy provider: LLM_PROVIDER=openai and all three values below
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
PDF_BROWSER_PATH=
# Production requires DATABASE_URL, HTTPS origin, strong secrets and isolated runner.
# Runner only: Linux /dev/kvm, firecracker binary, immutable kernel/rootfs.
API_URL=http://localhost:3001
FIRECRACKER_BIN=/usr/local/bin/firecracker
KERNEL_PATH=/opt/algostep/vmlinux
ROOTFS_PATH=/opt/algostep/rootfs.ext4
KERNEL_SHA256=
ROOTFS_SHA256=
RUNNER_WORKDIR=/var/lib/algostep
RUNNER_SLOTS=2
# Optional production operations and private trace storage
OPERATIONS_TOKEN=
SCHEDULER_AUDIENCE=
SCHEDULER_EMAIL=
TRACE_BUCKET=
BACKGROUND_WORKER=true
WORKER_AUTOSCALE=false
GCP_PROJECT=algostep
WORKER_ZONE=us-central1-a
WORKER_NAMES=algostep-worker-1,algostep-worker-2
WORKER_IDLE_SECONDS=900
RUNNER_SLOTS_PER_HOST=2
# Runner only; must match its managed instance name when autoscaling is enabled.
WORKER_NAME=
# WEB_DIST is supplied by the combined Cloud Run image
